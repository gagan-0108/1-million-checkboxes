# Server
PORT=7000
NODE_ENV=development

# Redis — Option 1: Connection URL (used by Render, Railway, etc.)
# REDIS_URL=redis://default:password@host:port

# Redis — Option 2: Separate host/port (used locally / docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:7000/auth/google/callback

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Client URL (set to your production domain in production)
CLIENT_URL=http://localhost:7000

# Checkbox config
CHECKBOX_COUNT=1000000
